{
    "ci": {
        "collect": {
            "staticDistDir": "./dist",
            "url": ["http://localhost/"],
            "numberOfRuns": 3
        },
        "assert": {
            "preset": "lighthouse:no-pwa",
            "assertions": {
                "largest-contentful-paint": "off",
                "interactive": "off",
                "redirects": "off",
                "third-party-facades": "off",
                "image-delivery-insight": "warn"
            }
        },
        "upload": {
            "target": "temporary-public-storage"
        }
    }
}
