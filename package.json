{
    "name": "tanh-lab-web",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun --hot ./dev-server.ts",
        "build": "bun run build.ts",
        "brand": "bun run tools/render-brand.ts",
        "start": "bun ./index.html",
        "type-check": "node_modules/typescript7/bin/tsc --noEmit",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "type-check:ts6": "tsc --noEmit"
    },
    "dependencies": {
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bun": "^1.4.2",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "eslint": "^10.10.0",
        "eslint-plugin-jsx-a11y-x": "^0.2.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "typescript7": "npm:typescript@^7.0.2"
    }
}
