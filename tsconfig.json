{
    "compilerOptions": {
        "lib": ["dom", "dom.iterable", "esnext"],
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "types": ["bun"],
        "paths": { "@/*": ["./src/*"] }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.d.ts",
        "build.ts",
        "dev-server.ts"
    ],
    "exclude": ["node_modules", "dist"]
}
